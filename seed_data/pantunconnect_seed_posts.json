[
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Beras basah mari taburkan,\nPengantin diarak gelak ketawa;\nPuas sudah hamba hiburkan.\nHati rindu terkenang jua.",
    "backgroundImageUrl": "",
    "category": "Jenaka",
    "hashtags": [
      "Jenaka",
      "JohordanMelaka"
    ],
    "timestamp": 1782913608000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 361,
    "_sourceNegeri": "Johor dan Melaka"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Ingai puan ingai selasih,\nIngati kembagau berambu-rambu;\nTinggal tuan tinggal kekasih.\nAda hayat baru bertemu.",
    "backgroundImageUrl": "",
    "category": "Cinta & Kasih Sayang",
    "hashtags": [
      "Cinta",
      "Sabah"
    ],
    "timestamp": 1782870408000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 5338,
    "_sourceNegeri": "Sabah"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Ke Muar sudah ke ladang belum\nAnak beranak mengambil angin\nPandang sudah temu belum\nIbarat gambar dalam cerita",
    "backgroundImageUrl": "",
    "category": "Peribahasa & Kiasan",
    "hashtags": [
      "Peribahasa",
      "KelantanTerengganudanPahang"
    ],
    "timestamp": 1782827208000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 3705,
    "_sourceNegeri": "Kelantan Terengganu dan Pahang"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Banyak ubi perkara ubi,\nUbi Daik saya tanamkan;\nBanyak budi perkara budi,\nBudi baik saya kenangkan.",
    "backgroundImageUrl": "",
    "category": "Budi & Adab",
    "hashtags": [
      "BudiAdab",
      "SelangordanNegeriSembilan"
    ],
    "timestamp": 1782784008000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 1869,
    "_sourceNegeri": "Selangor dan Negeri Sembilan"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Naik bukit sebalik bukit,\nBuat tetap pagar anak;\nCari tenggek sapu tangan batik,\nCari janda belum beranak.",
    "backgroundImageUrl": "",
    "category": "Budi & Adab",
    "hashtags": [
      "BudiAdab",
      "KelantanTerengganudanPahang"
    ],
    "timestamp": 1782740808000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 3857,
    "_sourceNegeri": "Kelantan Terengganu dan Pahang"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Sungguh kuat terbang tekukur,\nSayap berbunyi mendayu-dayu;\nSungguhpun tajam pisau cukur,\nTapi tak boleh dipotong kayu.",
    "backgroundImageUrl": "",
    "category": "Nasihat & Moral",
    "hashtags": [
      "Nasihat",
      "JohordanMelaka"
    ],
    "timestamp": 1782697608000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 1643,
    "_sourceNegeri": "Johor dan Melaka"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Pun tali pun,\nAnak ayam bulu balik;\nDalam perintah Jepun.\nKita makan ubi keledek.",
    "backgroundImageUrl": "",
    "category": "Jenaka",
    "hashtags": [
      "Jenaka",
      "JohordanMelaka"
    ],
    "timestamp": 1782654408000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 1466,
    "_sourceNegeri": "Johor dan Melaka"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Saya tidak membakar arang,\nAbang mengepit si bunga dedap;\nSaya tidak kata sebarang,\nKerana abang tak tahu adab.",
    "backgroundImageUrl": "",
    "category": "Budi & Adab",
    "hashtags": [
      "BudiAdab",
      "KelantanTerengganudanPahang"
    ],
    "timestamp": 1782611208000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 4175,
    "_sourceNegeri": "Kelantan Terengganu dan Pahang"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Rambutku jangan ditocang,\nIndung saya di jari manis;\nPetang-petang surat datang,\nBelum dibaca dulu menangis.",
    "backgroundImageUrl": "",
    "category": "Cinta & Kasih Sayang",
    "hashtags": [
      "Cinta",
      "Sarawak"
    ],
    "timestamp": 1782568008000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 4899,
    "_sourceNegeri": "Sarawak"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Sayang serindit punai di Jawa,\nPermainan anak permaisuri;\nPelepah jatuh pucuk ketawa,\nPangkal juga menahan diri.",
    "backgroundImageUrl": "",
    "category": "Jenaka",
    "hashtags": [
      "Jenaka",
      "JohordanMelaka"
    ],
    "timestamp": 1782524808000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 1578,
    "_sourceNegeri": "Johor dan Melaka"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Tidak tahan sakit kaki,\nKena duri dalam petak:\nTidak tahan sakit hati,\nOrang menyindir dalam gelak.",
    "backgroundImageUrl": "",
    "category": "Jenaka",
    "hashtags": [
      "Jenaka",
      "JohordanMelaka"
    ],
    "timestamp": 1782481608000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 1734,
    "_sourceNegeri": "Johor dan Melaka"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Hisap rokok tembakau Jawa\nAsap keluar berbunga-bunga\nTumpang bertanya si baju kasa\nTumpang bertanya siapa nama?",
    "backgroundImageUrl": "",
    "category": "Nasihat & Moral",
    "hashtags": [
      "Nasihat",
      "Sarawak"
    ],
    "timestamp": 1782438408000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 4671,
    "_sourceNegeri": "Sarawak"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Kain culas di atas peti\nDitekad jangan diberi jangan\nSudah ikhlas dalam hati\nDiumpat jangan dipuji jangan",
    "backgroundImageUrl": "",
    "category": "Budi & Adab",
    "hashtags": [
      "BudiAdab",
      "KelantanTerengganudanPahang"
    ],
    "timestamp": 1782395208000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 3585,
    "_sourceNegeri": "Kelantan Terengganu dan Pahang"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Anak ungka terbang cepat,\nAnak kedidi berjalan sedepa:\nBukan senang mencari sahabat,\nSahabat berbudi sukar dijumpa.",
    "backgroundImageUrl": "",
    "category": "Budi & Adab",
    "hashtags": [
      "BudiAdab",
      "JohordanMelaka"
    ],
    "timestamp": 1782352008000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 189,
    "_sourceNegeri": "Johor dan Melaka"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Sayang beruas datang Singapura,\nTinggal berlabuh di Muara Rejang:\nTidak pun kita berjodoh semula,\nEloklah abang kembali pulang.",
    "backgroundImageUrl": "",
    "category": "Cinta & Kasih Sayang",
    "hashtags": [
      "Cinta",
      "Sarawak"
    ],
    "timestamp": 1782308808000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 4946,
    "_sourceNegeri": "Sarawak"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Encik Esah pergi Merlong,\nBuah papaya dibikin wajik;\nOrang susah jangan ditolong,\nKalau dah kaya kita diejek.",
    "backgroundImageUrl": "",
    "category": "Budi & Adab",
    "hashtags": [
      "BudiAdab",
      "JohordanMelaka"
    ],
    "timestamp": 1782265608000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 712,
    "_sourceNegeri": "Johor dan Melaka"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Tetak tebu betung\nSandar pokok inai\nSelawat gajah Tuk Dong\nSaya nampak Tuk Nai",
    "backgroundImageUrl": "",
    "category": "Jenaka",
    "hashtags": [
      "Jenaka",
      "PerakKedahdanPerlis"
    ],
    "timestamp": 1782222408000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 2975,
    "_sourceNegeri": "Perak Kedah dan Perlis"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Sembahyang bersama-sama,\nAngkat tabir Allahuakbar;\nKalau tuan tidak percaya,\nMari bersumpah di atas mimbar.",
    "backgroundImageUrl": "",
    "category": "Agama & Spiritual",
    "hashtags": [
      "Agama",
      "Sabah"
    ],
    "timestamp": 1782179208000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 5576,
    "_sourceNegeri": "Sabah"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Jurumudi pegang kemudi,\nNyiur bakul peninjau kerang;\nBukan sebabnya tidak berbudi,\nJangan ketara kepada orang.",
    "backgroundImageUrl": "",
    "category": "Budi & Adab",
    "hashtags": [
      "BudiAdab",
      "Sabah"
    ],
    "timestamp": 1782136008000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 5358,
    "_sourceNegeri": "Sabah"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Wayang balik pintu\nKain balik dinding\nPinang anak datu\nJatuh pelepah belimbing",
    "backgroundImageUrl": "",
    "category": "Jenaka",
    "hashtags": [
      "Jenaka",
      "PerakKedahdanPerlis"
    ],
    "timestamp": 1782092808000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 2996,
    "_sourceNegeri": "Perak Kedah dan Perlis"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Bertolak dari Mesapol,\nMari menuju pergi Labuan;\nApa manis gula sepikul\nManis lagi dindamu tuan",
    "backgroundImageUrl": "",
    "category": "Nasihat & Moral",
    "hashtags": [
      "Nasihat",
      "Sabah"
    ],
    "timestamp": 1782049608000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 5210,
    "_sourceNegeri": "Sabah"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Kalau tidak menanam selasih,\nAmbil pedada letak titi;\nKamek di sini bertanya kekasih,\nAmbil kami sebagai ganti.",
    "backgroundImageUrl": "",
    "category": "Cinta & Kasih Sayang",
    "hashtags": [
      "Cinta",
      "Sarawak"
    ],
    "timestamp": 1782006408000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 4739,
    "_sourceNegeri": "Sarawak"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Buluh ditetak senjakala,\nBuat mari pasak perahu;\nPasang pelita senjakala,\nSatu makhluk tidak tahu.",
    "backgroundImageUrl": "",
    "category": "Peribahasa & Kiasan",
    "hashtags": [
      "Peribahasa",
      "JohordanMelaka"
    ],
    "timestamp": 1781963208000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 479,
    "_sourceNegeri": "Johor dan Melaka"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Kain pelikat raginya dua\nDisandang orang pergi mengail\nAwang bangsat hati penghiba\nDi tanah Kelang nan kekal",
    "backgroundImageUrl": "",
    "category": "Nasihat & Moral",
    "hashtags": [
      "Nasihat",
      "SelangordanNegeriSembilan"
    ],
    "timestamp": 1781920008000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 1998,
    "_sourceNegeri": "Selangor dan Negeri Sembilan"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Tuai padi selasih dulang,\nSaya tumpang secawan baja;\nBuah hati dimaklum orang,\nSaya menumpang kawan saja.",
    "backgroundImageUrl": "",
    "category": "Cinta & Kasih Sayang",
    "hashtags": [
      "Cinta",
      "JohordanMelaka"
    ],
    "timestamp": 1781876808000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 1758,
    "_sourceNegeri": "Johor dan Melaka"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Paya darat paya telemu,\nDaun serbat di dalam padi;\nSaya ibarat air kuminum,\nHaram tak larut di dalam hati.",
    "backgroundImageUrl": "",
    "category": "Peribahasa & Kiasan",
    "hashtags": [
      "Peribahasa",
      "KelantanTerengganudanPahang"
    ],
    "timestamp": 1781833608000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 3968,
    "_sourceNegeri": "Kelantan Terengganu dan Pahang"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Kalau putih kata putih\nKanda sudah jatuh tiarap\nKalau boleh kata boleh\nMudah saya terharap-harap",
    "backgroundImageUrl": "",
    "category": "Nasihat & Moral",
    "hashtags": [
      "Nasihat",
      "KelantanTerengganudanPahang"
    ],
    "timestamp": 1781790408000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 3634,
    "_sourceNegeri": "Kelantan Terengganu dan Pahang"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Mengail Sungai Dua,\nUmpan pucuk keledek;\nTua samalah tua,\nSama-sama mencincang gobek.",
    "backgroundImageUrl": "",
    "category": "Jenaka",
    "hashtags": [
      "Jenaka",
      "SelangordanNegeriSembilan"
    ],
    "timestamp": 1781747208000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 2110,
    "_sourceNegeri": "Selangor dan Negeri Sembilan"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Haluan sarat banyak muatan,\nNampak cahaya batu karang;\nTuan ibarat permata intan,\nDi mana tercampak di situ terang.",
    "backgroundImageUrl": "",
    "category": "Peribahasa & Kiasan",
    "hashtags": [
      "Peribahasa",
      "JohordanMelaka"
    ],
    "timestamp": 1781704008000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 751,
    "_sourceNegeri": "Johor dan Melaka"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Ya Allah alaikum mukminin,\nTerangmu seperti cahaya cermin;\nTuan laksana kayu beringin,\nLemah dan lembut ditiup angin.",
    "backgroundImageUrl": "",
    "category": "Agama & Spiritual",
    "hashtags": [
      "Agama",
      "Sarawak"
    ],
    "timestamp": 1781660808000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 5095,
    "_sourceNegeri": "Sarawak"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Mari dikait sarang tempua,\nAnak tiung pandai meniti;\nHamba duduk gelak ketawa,\nUntuk mencari penghibur hati.",
    "backgroundImageUrl": "",
    "category": "Jenaka",
    "hashtags": [
      "Jenaka",
      "KelantanTerengganudanPahang"
    ],
    "timestamp": 1781617608000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 3815,
    "_sourceNegeri": "Kelantan Terengganu dan Pahang"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Kapal Inggeris Kapten Jerman,\nTeluk meneluk di Negeri Jawa;\nPutih kuning merubah iman,\nHitam manis merubah nyawa.",
    "backgroundImageUrl": "",
    "category": "Agama & Spiritual",
    "hashtags": [
      "Agama",
      "Sabah"
    ],
    "timestamp": 1781574408000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 5391,
    "_sourceNegeri": "Sabah"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Ambil parang cangkulkan tunggul,\nTunggul ada berikat tali;\nRakyat kurang senjata tumpul,\nRakyat di kota separuh mati.",
    "backgroundImageUrl": "",
    "category": "Nasihat & Moral",
    "hashtags": [
      "Nasihat",
      "JohordanMelaka"
    ],
    "timestamp": 1781531208000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 53,
    "_sourceNegeri": "Johor dan Melaka"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Ikan selangat dua serupa,\nYang satu ikan selayang;\nAdik kasih abang tak lupa,\nSama-sama berkasih sayang.",
    "backgroundImageUrl": "",
    "category": "Cinta & Kasih Sayang",
    "hashtags": [
      "Cinta",
      "JohordanMelaka"
    ],
    "timestamp": 1781488008000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 836,
    "_sourceNegeri": "Johor dan Melaka"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Orang bersalam di dalam perahu\nMakan ubi dengan korma\nOrang Islam hendaklah tahu\nBilangan nabi dua puluh lima",
    "backgroundImageUrl": "",
    "category": "Agama & Spiritual",
    "hashtags": [
      "Agama",
      "KelantanTerengganudanPahang"
    ],
    "timestamp": 1781444808000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 3912,
    "_sourceNegeri": "Kelantan Terengganu dan Pahang"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Bawa balik daun beringin,\nMari diletak di atas tangga;\nSudah nasib badan begini,\nSudah jatuh ditimpa tangga.",
    "backgroundImageUrl": "",
    "category": "Peribahasa & Kiasan",
    "hashtags": [
      "Peribahasa",
      "KelantanTerengganudanPahang"
    ],
    "timestamp": 1781401608000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 3210,
    "_sourceNegeri": "Kelantan Terengganu dan Pahang"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Kalau abang pergi ke pasar.\nBelikan saya ketam lumut;\nKalau abang pergi belayar,\nTinggalkan saya kain selimut.",
    "backgroundImageUrl": "",
    "category": "Agama & Spiritual",
    "hashtags": [
      "Agama",
      "JohordanMelaka"
    ],
    "timestamp": 1781358408000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 926,
    "_sourceNegeri": "Johor dan Melaka"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Keretapi tak ada serombong\nKapal pergi ke Batu Pahat\nSekali-kali saya tak sombong\nTapilah tuan tak tahu adat",
    "backgroundImageUrl": "",
    "category": "Budi & Adab",
    "hashtags": [
      "BudiAdab",
      "KelantanTerengganudanPahang"
    ],
    "timestamp": 1781315208000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 3722,
    "_sourceNegeri": "Kelantan Terengganu dan Pahang"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Anak ayam turun lima,\nSatu mati tinggal empat;\nDisuruh menuntut pada ulama,\nSupaya terang jalan makrifat.",
    "backgroundImageUrl": "",
    "category": "Agama & Spiritual",
    "hashtags": [
      "Agama",
      "JohordanMelaka"
    ],
    "timestamp": 1781272008000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 69,
    "_sourceNegeri": "Johor dan Melaka"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Mali-mali hujung pangkalnya,\nAsam kandis asam gelugur:\nKembalilah dagang asalnya,\nDuduk menangis pintu kubur.",
    "backgroundImageUrl": "",
    "category": "Agama & Spiritual",
    "hashtags": [
      "Agama",
      "JohordanMelaka"
    ],
    "timestamp": 1781228808000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 1146,
    "_sourceNegeri": "Johor dan Melaka"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Ke Badam sudah ke Muar belum,\nAnak beranak mengambil angin;\nTemu sudah kupandang belum,\nIbarat gambar dalam cermin.",
    "backgroundImageUrl": "",
    "category": "Peribahasa & Kiasan",
    "hashtags": [
      "Peribahasa",
      "JohordanMelaka"
    ],
    "timestamp": 1781185608000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 1028,
    "_sourceNegeri": "Johor dan Melaka"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Ayam bulu balik,\nTelur atas bara;\nAbang baru balik,\nTidak bawa apa.",
    "backgroundImageUrl": "",
    "category": "Jenaka",
    "hashtags": [
      "Jenaka",
      "PerakKedahdanPerlis"
    ],
    "timestamp": 1781142408000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 2387,
    "_sourceNegeri": "Perak Kedah dan Perlis"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Abang sayang disuruh panggilan,\nSuruh nyanyi, kena suruh;\nSeperti pungguk rindukan bulan,\nDisuruh jatuh tak akan jatuh.",
    "backgroundImageUrl": "",
    "category": "Peribahasa & Kiasan",
    "hashtags": [
      "Peribahasa",
      "KelantanTerengganudanPahang"
    ],
    "timestamp": 1781099208000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 4373,
    "_sourceNegeri": "Kelantan Terengganu dan Pahang"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Rusa ini rusa betina\nKalau mandi berkubang jangan\nMusim ini musim tua\nKalau mati berkurang jangan",
    "backgroundImageUrl": "",
    "category": "Nasihat & Moral",
    "hashtags": [
      "Nasihat",
      "KelantanTerengganudanPahang"
    ],
    "timestamp": 1781056008000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 4138,
    "_sourceNegeri": "Kelantan Terengganu dan Pahang"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Singapura negeri selat,\nSelat bernama Johor Bahru:\nPura-pura tidak dilihat,\nTapi hati bagai digaru.",
    "backgroundImageUrl": "",
    "category": "Cinta & Kasih Sayang",
    "hashtags": [
      "Cinta",
      "JohordanMelaka"
    ],
    "timestamp": 1781012808000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 1618,
    "_sourceNegeri": "Johor dan Melaka"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Angin darat angin utara,\nTinggi petak pada ruang;\nJangan harap pada saya,\nHak tiada bahasa pun kurang.",
    "backgroundImageUrl": "",
    "category": "Nasihat & Moral",
    "hashtags": [
      "Nasihat",
      "KelantanTerengganudanPahang"
    ],
    "timestamp": 1780969608000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 3114,
    "_sourceNegeri": "Kelantan Terengganu dan Pahang"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Sagu ladang makan dek kuda\nAnak udang balik batu\nTidak padan dengan kita\nApa abang kata begitu",
    "backgroundImageUrl": "",
    "category": "Nasihat & Moral",
    "hashtags": [
      "Nasihat",
      "KelantanTerengganudanPahang"
    ],
    "timestamp": 1780926408000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 4139,
    "_sourceNegeri": "Kelantan Terengganu dan Pahang"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Tuan Melana saya Melini,\nMakan terubuk seorang menelan;\nKekasih di sana abang di sini,\nIbarat pungguk rindukan bulan.",
    "backgroundImageUrl": "",
    "category": "Peribahasa & Kiasan",
    "hashtags": [
      "Peribahasa",
      "JohordanMelaka"
    ],
    "timestamp": 1780883208000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 1765,
    "_sourceNegeri": "Johor dan Melaka"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Rumah kecil tiang seribu\nRumah besar tiang sebatang\nKecil-kecil ditimang ibu\nSudah besar menimang abang",
    "backgroundImageUrl": "",
    "category": "Agama & Spiritual",
    "hashtags": [
      "Agama",
      "KelantanTerengganudanPahang"
    ],
    "timestamp": 1780840008000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 4130,
    "_sourceNegeri": "Kelantan Terengganu dan Pahang"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Jantung ini jantung sekerat\nLimau purut dalam ceper\nPantun ini pantun ibarat\nDalam perut mencari fikir",
    "backgroundImageUrl": "",
    "category": "Peribahasa & Kiasan",
    "hashtags": [
      "Peribahasa",
      "KelantanTerengganudanPahang"
    ],
    "timestamp": 1780796808000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 3566,
    "_sourceNegeri": "Kelantan Terengganu dan Pahang"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Bagaimana tidak di rimba,\nLalu jatuh dari durinya;\nBagaimana tidak dicinta\nHatiku hancur mengenang budinya",
    "backgroundImageUrl": "",
    "category": "Budi & Adab",
    "hashtags": [
      "BudiAdab",
      "Sarawak"
    ],
    "timestamp": 1780753608000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 4451,
    "_sourceNegeri": "Sarawak"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Nasi lemak bergulai udang,\nLemak berbau belum dirasa;\nRemuklah hati berputih tulang,\nTidak direla berputih mata.",
    "backgroundImageUrl": "",
    "category": "Cinta & Kasih Sayang",
    "hashtags": [
      "Cinta",
      "JohordanMelaka"
    ],
    "timestamp": 1780710408000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 1211,
    "_sourceNegeri": "Johor dan Melaka"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Ikan puyu lemak,\nMasak kuah lada;\nIntan rangkul emak,\nBuah hati emak juga.",
    "backgroundImageUrl": "",
    "category": "Jenaka",
    "hashtags": [
      "Jenaka",
      "KelantanTerengganudanPahang"
    ],
    "timestamp": 1780667208000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 3540,
    "_sourceNegeri": "Kelantan Terengganu dan Pahang"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Paya Balais di tanah lumpur,\nTempat orang bertanam padi;\nRasa di hati luluh hancur,\nBelum berjumpa belum berhenti.",
    "backgroundImageUrl": "",
    "category": "Cinta & Kasih Sayang",
    "hashtags": [
      "Cinta",
      "Sabah"
    ],
    "timestamp": 1780624008000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 5505,
    "_sourceNegeri": "Sabah"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Bukan gambus gila di pekan,\nMelagui hendak berpantun;\nBukan bagus kami gilakan\nAkal dan budi yang dialu-alukan",
    "backgroundImageUrl": "",
    "category": "Budi & Adab",
    "hashtags": [
      "BudiAdab",
      "Sabah"
    ],
    "timestamp": 1780580808000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 5234,
    "_sourceNegeri": "Sabah"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Sudah berdebu berderai pula,\nBerderai sampai ke kota raja;\nSudah bertemu bercerai pula,\nTinggallah tuan cahaya mata.",
    "backgroundImageUrl": "",
    "category": "Agama & Spiritual",
    "hashtags": [
      "Agama",
      "KelantanTerengganudanPahang"
    ],
    "timestamp": 1780537608000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 4221,
    "_sourceNegeri": "Kelantan Terengganu dan Pahang"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Mualana Si Maulani,\nKucing bubuk makan di pinggan;\nMahu di sana mahu di sini,\nSeperti pungguk rindukan bulan.",
    "backgroundImageUrl": "",
    "category": "Peribahasa & Kiasan",
    "hashtags": [
      "Peribahasa",
      "Sabah"
    ],
    "timestamp": 1780494408000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 5460,
    "_sourceNegeri": "Sabah"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Rambai lebat di tepi padi,\nLagi dijurai lagi ditutuh;\nKalau boleh bagai di hati,\nRambut sehelai belah tujuh.",
    "backgroundImageUrl": "",
    "category": "Cinta & Kasih Sayang",
    "hashtags": [
      "Cinta",
      "KelantanTerengganudanPahang"
    ],
    "timestamp": 1780451208000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 4100,
    "_sourceNegeri": "Kelantan Terengganu dan Pahang"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Malam ini malam Ahad,\nMalam besok malam Isnin;\nInilah jalan, jalan makrifat,\nTuntutlah ilmu sampai berkenan.",
    "backgroundImageUrl": "",
    "category": "Agama & Spiritual",
    "hashtags": [
      "Agama",
      "KelantanTerengganudanPahang"
    ],
    "timestamp": 1780408008000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 3799,
    "_sourceNegeri": "Kelantan Terengganu dan Pahang"
  },
  {
    "authorId": "seed_curator_01",
    "authorName": "Arkib Pantun",
    "authorProfilePictureUrl": "",
    "content": "Kalau nak jatuh baik disambut,\nTakut putus tali perambut;\nJika belayar tak kena ribut,\nTakut kena perompak di laut.",
    "backgroundImageUrl": "",
    "category": "Nasihat & Moral",
    "hashtags": [
      "Nasihat",
      "JohordanMelaka"
    ],
    "timestamp": 1780364808000,
    "likesCount": 0,
    "commentsCount": 0,
    "_sourceNoAsal": 961,
    "_sourceNegeri": "Johor dan Melaka"
  }
]