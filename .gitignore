# Firebase Admin SDK service account key - never commit, grants admin access to the project.
# If this file needs to exist locally (e.g. for seed_data/import_seed_data.js), download a fresh
# one from Firebase Console > Project Settings > Service Accounts and keep it out of git.
seed_data/serviceAccountKey.json

# Node dependencies for the seed_data scripts - regenerate locally with `npm install`, never
# commit node_modules.
seed_data/node_modules/
