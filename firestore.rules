rules_version = '2';

// PANTUN-CONNECT Firestore security rules.
//
// Deploy: Firebase Console > Firestore Database > Rules tab > paste > Publish.
// Takes effect within seconds - no app rebuild needed. Shared by BOTH the Kotlin
// and Flutter apps (same backend).
//
// Model: signed-in users can read public content (posts, profiles, follows) and
// write their own content. Chats are only visible to their participants.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // ---- Posts (public feed) ----
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      // Any signed-in user may update (needed for likesCount/commentsCount bumps).
      allow update: if signedIn();
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
        allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      }

      match /likes/{userId} {
        allow read: if signedIn();
        allow write: if isOwner(userId);
      }
    }

    // ---- User profiles ----
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId);
      // Owners can update their own profile freely; other signed-in users may ONLY touch the
      // follower/following counters (needed because following someone updates both users'
      // counts in one batch - without this, every follow attempt is denied).
      allow update: if isOwner(userId)
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['followersCount', 'followingCount']));

      match /saved_posts/{postId} {
        allow read, write: if isOwner(userId);
      }

      match /blocked_users/{blockedId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        // Anyone signed-in may create a notification for another user
        // (like/comment/follow events).
        allow create: if signedIn();
      }
    }

    // ---- Follow relationships ----
    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.followerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.followerId == request.auth.uid;
    }

    // ---- Direct messages ----
    match /chats/{chatId} {
      allow read, update: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read, create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // ---- Abuse reports (write-only for users) ----
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read: if false; // admin-only via console/backend
    }
  }
}
